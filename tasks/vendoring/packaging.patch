+def _bisect_predicate(
+    items: Sequence[Version], predicate: Callable[[Version], bool]
+) -> int:
+    """Return the first true position of a monotone predicate over versions."""
+    low, high = 0, len(items)
+    while low < high:
+        mid = (low + high) // 2
+        if predicate(items[mid]):
+            high = mid
+        else:
+            low = mid + 1
+    return low
+
